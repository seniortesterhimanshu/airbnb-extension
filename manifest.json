{
  "manifest_version": 3,
  "name": "Airbnb Smart Sorting",
  "version": "1.0.0",
  "description": "Advanced sorting for Airbnb - by nearby locations and budget",
  "permissions": [
    "geolocation",
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://www.airbnb.com/*",
    "https://airbnb.com/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_title": "Airbnb Smart Sorting"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://www.airbnb.com/*", "https://airbnb.com/*"],
      "js": ["src/content/content.js"],
      "run_at": "document_end"
    }
  ]
}
